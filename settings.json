/** @format */

{
	"editor.quickSuggestions": {
		"other": "on",
		"comments": "on",
		"strings": "on",
	},
	"editor.suggest.showWords": false,
	"editor.quickSuggestionsDelay": 0,
	"editor.suggestOnTriggerCharacters": true,
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.smoothScrolling": true,
	"editor.fastScrollSensitivity": 20,
	"editor.autoClosingBrackets": "never",
	"editor.autoClosingQuotes": "never",
	"editor.autoSurround": "never",
	"window.autoDetectColorScheme": false,
	"workbench.preferredDarkColorTheme": "Catppuccin Macchiato",
	"files.autoSave": "onFocusChange",
	"editor.fontSize": 16,
	"editor.fontFamily": "'Maple Mono NF CN Regular', Consolas, 'Courier New', monospace",
	"editor.fontLigatures": true,
	"editor.fontWeight": "300",
	"vscode-neovim.compositeKeys": {},
	"vscode-neovim.neovimClean": false,
	"extensions.experimental.affinity": {
		"asvetliakov.vscode-neovim": 1,
	},
	"editor.foldingStrategy": "indentation",
	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.defaultFoldingRangeProvider": "SeyMi.smart-folding",
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.defaultFoldingRangeProvider": "SeyMi.smart-folding",
	},
	"catppuccin.bracketMode": "dimmed",
	"vscode-neovim.ctrlKeysForInsertMode": [
		"a",
		"c",
		"d",
		"h",
		"j",
		"m",
		"o",
		"r",
		"t",
		"u",
		"w",
		"b",
		"e",
		"f",
		"g",
		"i",
		"k",
		"l",
		"n",
		"p",
		"q",
		"s",
		"v",
		"x",
		"y",
		"z",
		"/",
		"]",
		"right",
		"left",
		"up",
		"down",
		"backspace",
		"delete",
	],
	"vscode-neovim.ctrlKeysForNormalMode": [
		"a",
		"b",
		"c",
		"d",
		"e",
		"f",
		"h",
		"i",
		"j",
		"k",
		"l",
		"m",
		"o",
		"r",
		"t",
		"u",
		"v",
		"w",
		"x",
		"y",
		"z",
		"/",
		"]",
		"right",
		"left",
		"up",
		"down",
		"backspace",
		"delete",
		"g",
		"n",
		"p",
		"q",
		"s",
	],
	"editor.formatOnSave": true,
	"[lua]": {
		"editor.defaultFormatter": "Koihik.vscode-lua-format",
	},
	"workbench.preferredHighContrastColorTheme": "Catppuccin Macchiato",
	"workbench.preferredHighContrastLightColorTheme": "Catppuccin Frappé",
	"workbench.preferredLightColorTheme": "Catppuccin Frappé",
	"[csharp]": {
		"editor.defaultFormatter": "csharpier.csharpier-vscode",
	},
	"workbench.layoutControl.enabled": false,
	"debug.inlineValues": false,
	"editor.minimap.enabled": true,
	"git.detectSubmodules": true,
	"git.repositoryScanMaxDepth": -1,
	"git.autoRepositoryDetection": true,
	"editor.semanticHighlighting.enabled": true,
	"editor.semanticTokenColorCustomizations": {
		"enabled": true,
		"rules": {
			"property.static": "#8bd5ca",
		},
	},
	"commentAnchors.showCursor": true,
	"commentAnchors.scrollPosition": "center",
	"commentAnchors.tags.matchCase": false,
	"commentAnchors.tags.separators": [" - ", ": ", " "],
	"commentAnchors.epic.provideAutoCompletion": true,
	"commentAnchors.tags.displayHierarchyInWorkspace": true,
	"commentAnchors.tags.displayInRuler": true,
	"commentAnchors.tags.sortMethod": "type",
	"commentAnchors.parseDelay": 200,
	"commentAnchors.tags.displayInSidebar": false,
	"commentAnchors.tags.anchors": {
		"ANCHOR": {
			"iconColor": "default",
			"highlightColor": "#bdb2ff",
			"scope": "file",
		},
		"TODO": {
			"iconColor": "blue",
			"highlightColor": "#3ea8ff",
			"scope": "workspace",
		},
		"FIXME": {
			"iconColor": "red",
			"highlightColor": "#F44336",
			"scope": "workspace",
		},
		"STUB": {
			"iconColor": "purple",
			"highlightColor": "#BA68C8",
			"scope": "file",
		},
		"NOTE": {
			"iconColor": "orange",
			"highlightColor": "#FFB300",
			"scope": "file",
		},
		"REVIEW": {
			"iconColor": "green",
			"highlightColor": "#64DD17",
			"scope": "workspace",
		},
		"SECTION": {
			"iconColor": "blurple",
			"highlightColor": "#896afc",
			"scope": "workspace",
			"behavior": "region",
		},
		"LINK": {
			"iconColor": "#2ecc71",
			"highlightColor": "#2ecc71",
			"scope": "workspace",
			"behavior": "link",
		},
	},
	"workbench.colorTheme": "Catppuccin Macchiato",
	"workbench.iconTheme": "catppuccin-macchiato",
	"commentAnchors.tags.endTag": "\\",
	"commentLens.highlightMode": "always",
	"commentLens.dividerTextPosition": "center",
	"commentLens.commentBoxTextPosition": "center",
	"commentLens.patterns": [
		{
			"id": "warn",
			"name": "Warning",
			"pattern": "@warn",
			"textColor": "rgba(220, 38, 38, 0.7)",
			"backgroundColor": "rgba(220, 38, 38, 0.1)",
			"enabled": true,
			"showTextColor": true,
			"showBackgroundColor": true,
			"overrideDefault": false,
		},
		{
			"id": "question",
			"name": "Question",
			"pattern": "@question",
			"textColor": "rgba(59, 130, 246, 0.7)",
			"backgroundColor": "rgba(59, 130, 246, 0.1)",
			"enabled": true,
			"showTextColor": true,
			"showBackgroundColor": true,
			"overrideDefault": false,
		},
		{
			"id": "todo",
			"name": "TODO",
			"pattern": "@todo",
			"textColor": "#3ea8ffff",
			"backgroundColor": "#3ea8ff10",
			"enabled": true,
			"showTextColor": true,
			"showBackgroundColor": true,
			"overrideDefault": true,
		},
		{
			"id": "fixme",
			"name": "FIXME",
			"pattern": "@fixme",
			"textColor": "#f44336ff",
			"backgroundColor": "#f4433610",
			"enabled": true,
			"showTextColor": true,
			"showBackgroundColor": true,
			"overrideDefault": true,
		},
		{
			"id": "note",
			"name": "Note",
			"pattern": "@note",
			"textColor": "rgba(34, 197, 94, 0.7)",
			"backgroundColor": "rgba(34, 197, 94, 0.1)",
			"enabled": true,
			"showTextColor": true,
			"showBackgroundColor": true,
			"overrideDefault": false,
		},
		{
			"id": "highlight",
			"name": "Highlight",
			"pattern": "@highlight:",
			"textColor": "rgba(234, 179, 8, 0.7)",
			"backgroundColor": "rgba(234, 179, 8, 0.1)",
			"enabled": true,
			"showTextColor": true,
			"showBackgroundColor": true,
			"overrideDefault": false,
		},
		{
			"id": "test",
			"name": "Test",
			"pattern": "@test",
			"textColor": "rgba(20, 184, 166, 0.7)",
			"backgroundColor": "rgba(20, 184, 166, 0.1)",
			"enabled": true,
			"showTextColor": true,
			"showBackgroundColor": true,
			"overrideDefault": false,
		},
		{
			"id": "status",
			"name": "Status",
			"pattern": "@status",
			"textColor": "rgba(0, 98, 255, 0.7)",
			"backgroundColor": "rgba(0, 98, 255, 0.1)",
			"enabled": true,
			"showTextColor": true,
			"showBackgroundColor": true,
			"overrideDefault": false,
		},
	],
	"turboFileHeader.companyName": "MEOWODY",
	"turboFileHeader.autoInsertOnCreateFile": true,
	"turboFileHeader.dateFormat": "YYYY-MM-DD HH:mm:ss",
	"turboFileHeader.tags": [
		{
			"tag": "#",
			"color": "#3388ffff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		{
			"tag": "!",
			"color": "#FF2D00",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": true,
			"italic": false,
		},
		{
			"tag": "&",
			"color": "#ff06a0ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false,
		},
		{
			"tag": "^",
			"color": "#eaf622ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false,
		},
		{
			"tag": "~",
			"color": "#be00ff",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false,
		},
		{
			"tag": "?",
			"color": "#f599c6",
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false,
		},
		{
			"tag": "//",
			"color": "#474747",
			"strikethrough": true,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false,
		},
		// {
		//   "tag": ["todo", "to-do"],
		//   "color": "#FF8C00",
		//   "strikethrough": false,
		//   "underline": false,
		//   "backgroundColor": "transparent",
		//   "bold": false,
		//   "italic": false,
		// },
		{
			"tag": "*",
			"color": "#28ff00", // #98c379
			"strikethrough": false,
			"underline": false,
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false,
		},
	],
	"turboFileHeader.autoUpdateOnSave": false,
	"turboFileHeader.patternMultiline": true,
	"turboFileHeader.updateHeaderForModifiedFilesOnly": true,
	"turboFileHeader.userEmail": "baizeyv@gmail.com",
	"turboFileHeader.userName": "baizeyv",
	"turboFileHeader.fileheader": [
		{
			"label": " * @file",
			"value": "{{filePath}}",
		},
		{
			"label": " * @description",
			"value": "{{description}}",
			"usePrevious": true,
		},
		{
			"label": " * @author",
			"value": "{{authorName}} <{{authorEmail}}>",
		},
		{
			"label": " * @createTime",
			"value": "{{birthtime}}",
			"usePrevious": true,
		},
		{
			"label": " * @lastModified",
			"value": "{{mtime}}",
		},
		{
			"label": "@copyright",
			"value": "{{copyright}}",
			"wholeLine": true,
		},
	],
	"turboFileHeader.useJSDocStyle": true,
	"turboFileHeader.highlightPlainText": true,
	"turboFileHeader.multilineComments": true,
	"turboFileHeader.languages": [
		{
			"id": "astro",
			"extensions": [".astro"],
			"aliases": ["astro"],
			"configuration": {
				"comments": {
					"blockComment": ["<!--", "-->"],
				},
			},
		},
		{
			"id": "vue",
			"extensions": [".vue"],
			"aliases": ["vue"],
			"configuration": {
				"comments": {
					"blockComment": ["<!--", "-->"],
				},
			},
		},
		{
			"id": "lua",
			"extensions": [".lua"],
			"aliases": ["lua"],
			"configuration": {
				"comments": {
					"blockComment": ["--[[", "]] --"],
					"lineComment": "--",
				},
			},
		},
	],
	"turboFileHeader.functionComment": {
		"languagesSettings": [
			{
				"languageId": "typescript",
				"defaultReturnName": "default",
				"defaultReturnType": "auto",
				"defaultParamType": "any",
				"typesUsingDefaultReturnType": ["void", "never", "unknown", "any"],
				"useTypeAlias": true,
				"paramNameBeforeType": true,
			},
			{
				"languageId": "java",
				"defaultReturnName": "default",
				"defaultReturnType": "auto",
				"defaultParamType": "any",
				"paramNameBeforeType": false,
			},
		],
	},
	"indentRainbow.colorOnWhiteSpaceOnly": true,
	"indentRainbow.indicatorStyle": "light",
	"indentRainbow.lightIndicatorStyleLineWidth": 1,
	"indentRainbow.colors": [
		"rgba(223,142,29,0.5)",
		"rgba(64,160,43,0.5)",
		"rgba(234,118,203,0.5)",
		"rgba(23,146,236,0.5)",
