/** @format */

// Place your key bindings in this file to override the defaults
[
	// ------------------------------------------------------------
	// TAB
	// ------------------------------------------------------------

	{
		"key": "tab",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init && !inSnippetMode",
		"args": "<C-g>t",
	},
	{
		"key": "tab",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init && inSnippetMode && !hasNextTabstop",
		"args": "<C-g>t",
	},
	{
		"key": "tab",
		"command": "jumpToNextSnippetPlaceholder",
		"when": "editorTextFocus && inSnippetMode && hasNextTabstop",
	},

	// ------------------------------------------------------------
	// SHIFT + TAB
	// ------------------------------------------------------------

	{
		"key": "shift+tab",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init && !inSnippetMode",
		"args": "<C-g>T",
	},
	{
		"key": "shift+tab",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init && inSnippetMode && !hasPrevTabstop",
		"args": "<C-g>T",
	},
	{
		"key": "shift+tab",
		"command": "jumpToPrevSnippetPlaceholder",
		"when": "editorTextFocus && inSnippetMode && hasPrevTabstop",
	},

	// ============================================================================
	// COPILOT
	// ============================================================================

	{
		"key": "ctrl+space",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<C-g>a",
	},

	{
		"key": "ctrl+backspace",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<C-g>r",
	},
	// ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
	// ================================================================
	// Enter
	//
	// Suggest Widget:
	//   Enter 接受补全
	//   然后通知 Neovim 执行 <C-y>
	//   用于你之前实现的自动 () / <>()
	// ================================================================
	{
		"key": "enter",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && suggestWidgetVisible && neovim.init",
		"args": "<C-y>",
	},
	// --------------------- split ----------------------
	{
		"key": "backspace",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init && neovim.mode == 'insert'",
		"args": "<BS>",
	},
	// --------------------- split ----------------------
	{
		"key": "`",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "`",
	},
	{
		"key": "shift+9",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "(",
	},
	{
		"key": "shift+0",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": ")",
	},
	{
		"key": "[",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "[",
	},
	{
		"key": "]",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "]",
	},
	{
		"key": "shift+[",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "{",
	},
	{
		"key": "shift+]",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "}",
	},
	{
		"key": "'",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "'",
	},
	{
		"key": "shift+'",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "\"",
	},
	{
		"key": "ctrl+.",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<C-.>",
	},
	{
		"key": "ctrl+,",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<C-,>",
	},
	{
		"key": "ctrl+-",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<C-->",
	},
	{
		"key": "ctrl+=",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<C-=>",
	},
	{
		"key": "ctrl+alt+'",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<C-A-'>",
	},
	{
		"key": "alt+u",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<A-u>",
	},
	{
		"key": "alt+e",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<A-e>",
	},
	{
		"key": "alt+/",
		"command": "vscode-neovim.send",
		"when": "editorTextFocus && neovim.init",
		"args": "<A-/>",
	},
	// ----------------------------------------------------------------------------------
	// ----------------------------------------------------------------------------------
	// ----------------------------------------------------------------------------------
	{
		"key": "ctrl+i",
		"command": "-composer.startComposerPrompt",
	},
	{
		"key": "ctrl+i",
		"command": "-editor.action.triggerSuggest",
		"when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !isGlass && !suggestWidgetVisible",
	},
	{
		"key": "ctrl+e",
		"command": "-workbench.action.quickOpen",
	},
	{
		"key": "ctrl+e",
		"command": "-cursor.toggleAgentWindowIDEUnification",
		"when": "!isGlass && workbenchState != 'empty'",
	},
	{
		"key": "ctrl+e",
		"command": "-editor.action.toggleScreenReaderAccessibilityMode",
		"when": "accessibilityHelpIsShown",
	},
	{
		"key": "ctrl+u",
		"command": "-editor.action.pageUpHover",
		"when": "editorHoverFocused",
	},
	{
		"key": "ctrl+u",
		"command": "-list.focusPageUp",
		"when": "listFocus && !inputFocus",
	},
	{
		"key": "ctrl+e",
		"command": "list.focusDown",
		"when": "inReferenceSearchEditor && neovim.mode == 'normal'",
	},
	{
		"key": "e",
		"command": "list.focusDown",
		"when": "listFocus && !inputFocus",
	},
	{
		"key": "ctrl+u",
		"command": "list.focusUp",
		"when": "inReferenceSearchEditor && neovim.mode == 'normal'",
	},
	{
		"key": "u",
		"command": "list.focusUp",
		"when": "listFocus && !inputFocus",
	},
	{
		"key": "shift+escape",
		"command": "workbench.action.showCommands",
	},
	{
		"key": "ctrl+shift+p",
		"command": "-workbench.action.showCommands",
	},
	{
		"key": "j",
		"command": "-list.focusDown",
		"when": "listFocus && !inputFocus",
	},
	{
		"key": "k",
		"command": "-list.focusUp",
		"when": "listFocus && !inputFocus",
	},
	{
		"key": "u",
		"command": "list.focusUp",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputFocused",
	},
	{
		"key": "k",
		"command": "-list.focusUp",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputFocused",
	},
	{
		"key": "e",
		"command": "list.focusDown",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputFocused",
	},
	{
		"key": "j",
		"command": "-list.focusDown",
		"when": "notebookEditorFocused && !inputFocus && !notebookOutputFocused",
	},
	{
		"key": "ctrl+e",
		"command": "workbench.action.quickOpenSelectNext",
		"when": "inQuickOpen && neovim.mode != 'cmdline'",
	},
	{
		"key": "ctrl+u",
		"command": "workbench.action.quickOpenSelectPrevious",
		"when": "inQuickOpen && neovim.mode != 'cmdline'",
	},
	{
		"key": "tab",
		"command": "-editor.action.inlineSuggest.commit",
		"when": "inlineEditIsVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editor.hasSelection && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editor.hasSelection && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible",
	},
	{
		"key": "tab",
		"command": "-editor.action.inlineSuggest.commit",
		"when": "inInlineEditsPreviewEditor",
	},
]

